# TrustGrid.AI Form Capture & Telemetry Webhook URL (Google Apps Script #1 Web App)
NEXT_PUBLIC_TRUSTGRID_FORM_API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_1_WEB_APP_ID/exec
NEXT_PUBLIC_TRUSTGRID_ANALYTICS_API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_1_WEB_APP_ID/exec
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_1_WEB_APP_ID/exec
VITE_TRUSTGRID_FORM_API_URL=https://script.google.com/macros/s/YOUR_SCRIPT_1_WEB_APP_ID/exec

# TrustGrid Google Spreadsheets Configuration
NEXT_PUBLIC_SHEET1_ID=YOUR_SHEET_1_SPREADSHEET_ID
NEXT_PUBLIC_SHEET2_ID=YOUR_SHEET_2_SPREADSHEET_ID
NEXT_PUBLIC_SHEET2_ANALYTICS_URL=https://script.google.com/macros/s/YOUR_SCRIPT_2_WEB_APP_ID/exec

# TrustGrid Core Analytics & Intelligence Engine (SQLite / WAL Embedded)
ANALYTICS_DB_PATH=./data/trustgrid_analytics.db
TRUSTGRID_ADMIN_KEY=trustgrid2026

# Optional External IP & Geo Intelligence Providers
# If omitted, server automatically utilizes Vercel/Cloudflare edge geo headers with fallback
MAXMIND_LICENSE_KEY=YOUR_MAXMIND_KEY
IPINFO_TOKEN=YOUR_IPINFO_TOKEN

# TRUSTGRID Jira Workspace Configuration (DealFlow - DFX)
JIRA_BASE_URL=https://trustworkz.atlassian.net
JIRA_PROJECT_KEY=DFX
JIRA_EMAIL=poojasri@trustgrid.ai
JIRA_API_TOKEN=YOUR_ATLASSIAN_API_TOKEN
JIRA_LEAD_ISSUE_TYPE=Lead_Record
JIRA_SUBTASK_ISSUE_TYPE=FollowUp

# LinkedIn API Integration (OAuth 2.0 Organization / Company Page Publisher)
LINKEDIN_CLIENT_ID=YOUR_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=YOUR_LINKEDIN_CLIENT_SECRET
LINKEDIN_REDIRECT_URI=https://trustgrid.ai/api/linkedin/callback
LINKEDIN_ORGANIZATION_ID=YOUR_LINKEDIN_ORGANIZATION_ID
LINKEDIN_SCOPES=w_organization_social r_organization_social rw_organization_admin openid profile email
# Optional direct access token:
# LINKEDIN_ACCESS_TOKEN=

